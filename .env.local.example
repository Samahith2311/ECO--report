# Copy this file to .env.local and replace the placeholders with your own values.
# Find them in the Supabase dashboard: Project Settings > API.
# Only the PUBLIC anon (or "publishable") key belongs here. Never put the service_role key in this file.
# .env.local is ignored by git, so your real values are never committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
